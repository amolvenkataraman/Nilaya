  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "tsc --noEmit -p tsconfig.json && biome check && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.106.0",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
